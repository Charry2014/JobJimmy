# JobJimmy local environment — copy this file to .env and fill in real values.
#
#   cp .env.example .env
#
# .env is git-ignored and must never be committed. The scripts read it only as a
# fallback: a variable already set in the shell (or by your IDE/secret manager)
# always wins. Values are read into memory and never printed.
#
# Format: one KEY=VALUE per line. Blank lines and lines starting with # are
# ignored. A leading `export` is allowed. Quote values that contain spaces.

# OpenRouter credential for the translation script and other application AI
# functions. Required for translation; see Documentation/OpenRouter-Setup.md.
OPENROUTER_API_KEY=

# OpenRouter model id used by the translation script, e.g. <provider>/<model-id>.
# Required for translation unless passed with --model.
OPENROUTER_MODEL=

# Optional path to a translation guidance JSON profile, overriding
# CV/Translation/german.json. Overridden per run by --guidance.
# OPENROUTER_TRANSLATION_GUIDANCE=CV/Translation/german.json

# Separate OpenRouter credential for live Jev fit and document checks. Required
# only for `jev_check.py --send`; may equal OPENROUTER_API_KEY.
OPENROUTER_JEV_API_KEY=
