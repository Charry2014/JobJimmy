{
  "$schema": "https://app.kilo.ai/config.json",
  // .kilo/rules/*.md are loaded automatically; listing project.md here as well
  // loaded it twice.
  //
  // A fixed model instead of the global openrouter/auto: the auto router
  // switches models mid-session (for example on upstream rate limits), and every
  // switch re-sends the whole uncached context. Claude Haiku 5.5 is eligible
  // under the account's ZDR guardrail and caches prompts cheaply. Switch to
  // openrouter/anthropic/claude-sonnet-5.5 for a session that needs stronger
  // drafting; see Documentation/Getting-Started.md.
  "model": "openrouter/anthropic/claude-haiku-5.5",
  // The global Serena (code navigation) and memory (knowledge graph) MCP
  // servers serve software projects. JobJimmy job-search work uses neither, and
  // their tool definitions are re-sent with every model call.
  "tools": {
    "serena_*": false,
    "memory_*": false
  },
  // Offer only the JobJimmy skills. Global and Claude skills (document formats,
  // browsers, agent configuration) are irrelevant here and their descriptions
  // are re-sent with every call.
  "permission": {
    "skill": {
      "*": "deny",
      "create-application": "allow",
      "tailor-cv": "allow",
      "write-cover-letter": "allow",
      "prepare-send-files": "allow"
    }
  }
}
